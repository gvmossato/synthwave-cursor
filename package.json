{
    "name": "synthwave-cursor",
    "displayName": "SynthWave '84 Cursor",
    "description": "Cursor fork of SynthWave '84. Same neon palette, with workbench colours adapted for Cursor.",
    "version": "1.0.0",
    "license": "MIT",
    "author": "Gabriel Mossato",
    "publisher": "synthwave-cursor",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/gvmossato/synthwave-cursor"
    },
    "engines": {
        "vscode": "^1.85.0",
        "node": ">=22"
    },
    "scripts": {
        "package": "vsce package --no-dependencies",
        "check": "vsce ls --no-dependencies"
    },
    "devDependencies": {
        "@vscode/vsce": "4.0.0"
    },
    "files": [
        "images/**",
        "themes/**",
        "examples/**",
        "LICENSE",
        "README.md"
    ],
    "extensionKind": [
        "ui"
    ],
    "keywords": [
        "retro",
        "80s",
        "cursor"
    ],
    "categories": [
        "Themes"
    ],
    "contributes": {
        "themes": [
            {
                "label": "SynthWave '84 Cursor",
                "uiTheme": "vs-dark",
                "path": "./themes/synthwave-color-theme.json"
            }
        ]
    }
}
